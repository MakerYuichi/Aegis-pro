# Copy to .env (gitignored). None of these values are secrets.

# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
DEBUG=true
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# --- Demo vs production ---
# true: public /api/v1/demo/* and mock GitHub/Slack for the dashboard.
DEMO_MODE=false
# read_only | pr_draft | auto_pr
AUTO_FIX_MODE=read_only

# --- Verifier (stage 4, sandboxed test execution) ---
# Off by default. When false, the pipeline runs as if verification
# succeeded, with reason="disabled" recorded so downstream consumers
# can tell "verified and passed" from "not verified."
VERIFY_BEFORE_REPORT=false
VERIFY_TIMEOUT_SECONDS=120
VERIFY_MAX_ATTEMPTS=2
VERIFY_DOCKER_IMAGE_PYTHON=python:3.11-slim
VERIFY_DOCKER_IMAGE_NODE=node:20-slim

# --- LLM (required for /demo repo analysis) ---
# groq | azure | ollama | gemini | openrouter | mock
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini,openrouter
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Auth0 (mutating APIs) ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# --- GitHub (authenticated product path; demo fetcher is unauthenticated) ---
GITHUB_TOKEN=
GITHUB_ORG=your-org

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_URL=

# --- Optional Kubernetes rollback ---
K8S_API_URL=
K8S_TOKEN=
K8S_NAMESPACE=production

# Absolute path on the host of the ./verifier-workdir bind mount.
# The verifier passes this path to the Docker daemon, which interprets
# it against the HOST filesystem — not the orchestrator container's.
#
# Default assumes the repo lives at the working directory root:
#   VERIFIER_HOST_WORKDIR=<absolute-path-to-repo>/verifier-workdir
#
# macOS example:
#   VERIFIER_HOST_WORKDIR=/Users/<you>/aegis-pro/verifier-workdir
# Linux example:
#   VERIFIER_HOST_WORKDIR=/home/<you>/aegis-pro/verifier-workdir
VERIFIER_HOST_WORKDIR=/var/lib/aegis/verifier-workdir

# UID:GID the orchestrator runs as inside the container. Must match
# the host user that owns ./verifier-workdir, so the verifier can
# write into the bind mount.
#
# Find yours:
#   id -u && id -g     # macOS: 501 and 20
#                      # Linux: usually 1000 and 1000
#
# The compose default (1000:1000) is fine for most Linux setups.
# macOS users should set these explicitly.
HOST_UID=1000
HOST_GID=1000

# Set DEMO_MODE=false to exercise the real pipeline (GitHub API,
# real verifier) instead of the mock services. Leave it true for
# the public demo deployment.
DEMO_MODE=false

# Set VERIFY_BEFORE_REPORT=true to run the Docker verifier against
# the repo's own tests. Requires Docker access and
# VERIFIER_HOST_WORKDIR set. Leave it false on deployments without
# Docker.
VERIFY_BEFORE_REPORT=false
