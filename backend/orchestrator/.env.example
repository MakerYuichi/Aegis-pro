# Database - Use local postgres from docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis

# Redis - Use local redis from docker-compose
REDIS_URL=redis://localhost:6379

# LLM - Get FREE API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# GitHub - Get FREE token from https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your-org-name

# Slack - Get FREE from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# App
SECRET_KEY=your-secret-key-here
DEBUG=true
APP_ENV=development