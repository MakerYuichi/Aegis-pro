# Copy to .env (gitignored). None of these values are secrets.

# --- Core ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aegis
REDIS_URL=redis://redis:6379/0
DEBUG=true
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# --- Demo vs production ---
# true: public /api/v1/demo/* and mock GitHub/Slack for the dashboard.
DEMO_MODE=false
# read_only | pr_draft | auto_pr
AUTO_FIX_MODE=read_only

# --- LLM (required for /demo repo analysis) ---
# groq | azure | ollama | gemini | openrouter | mock
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini,openrouter
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Auth0 (mutating APIs) ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# --- GitHub (authenticated product path; demo fetcher is unauthenticated) ---
GITHUB_TOKEN=
GITHUB_ORG=your-org

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_WEBHOOK_URL=

# --- Optional Kubernetes rollback ---
K8S_API_URL=
K8S_TOKEN=
K8S_NAMESPACE=production
