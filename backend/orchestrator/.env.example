# Database - Use local postgres from docker-compose
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aegis

#Auth
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier

# Redis - Use local redis from docker-compose
REDIS_URL=redis://localhost:6379

# LLM - Get FREE API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# GitHub - Get FREE token from https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
GITHUB_ORG=your-org-name

# Slack - Get FREE from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# App
SECRET_KEY=your-secret-key-here
DEBUG=true
APP_ENV=development

# LLM provider selection
LLM_PROVIDER=groq
LLM_FALLBACKS=gemini,openrouter

# Azure OpenAI (set LLM_PROVIDER=azure to use)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Ollama (set LLM_PROVIDER=ollama to use a self-hosted model)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1