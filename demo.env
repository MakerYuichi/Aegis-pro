# AEGIS PRO demo mode configuration.
#
# Usage:
#   docker-compose --env-file demo.env down -v
#   docker-compose --env-file demo.env up -d
#
# What this does:
#   - DEMO_MODE=true: enables the demo seed backfill and mock services
#   - LLM_PROVIDER=mock: no network calls to any LLM provider
#   - LLM_FALLBACKS= (empty): no fallback providers, mock is the only one
#   - AUTO_FIX_MODE=pr_draft: fix generation staged for approval, no PRs
#
# This file contains NO secrets. It is meant to be committed and shared.
# Personal credentials still live in backend/orchestrator/.env, which is
# gitignored.
#
# Requires a fresh volume to load the seed:
#   docker-compose --env-file demo.env down -v
# Without -v, Postgres keeps the old data directory and the seed SQL
# does not re-run.

DEMO_MODE=true
LLM_PROVIDER=mock
LLM_FALLBACKS=
AUTO_FIX_MODE=pr_draft
